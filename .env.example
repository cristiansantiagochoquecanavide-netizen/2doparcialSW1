# PostgreSQL used by docker compose and the Spring Boot development profile.
POSTGRES_DB=case_db
POSTGRES_USER=case_user
POSTGRES_PASSWORD=case_password
POSTGRES_PORT=5432

# Browser-visible configuration (empty means same-origin /api and /ws through Nginx).
VITE_API_BASE_URL=

# Production application configuration. Replace example values outside Git.
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_HOST
JWT_SECRET=replace-with-a-random-production-secret
JWT_EXPIRATION_MINUTES=480
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
