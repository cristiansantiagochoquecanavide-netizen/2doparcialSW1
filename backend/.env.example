SPRING_PROFILES_ACTIVE=dev
POSTGRES_PORT=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=case_db
DB_USERNAME=case_user
DB_PASSWORD=case_password
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-this-development-secret-to-a-safe-32-byte-minimum
JWT_EXPIRATION_MINUTES=480
VOICE_MAX_PARTICIPANTS=6
# Lista JSON de servidores ICE; vacía por defecto. No pongas credenciales TURN permanentes aquí.
VOICE_ICE_SERVERS_JSON=[]

# GroqCloud es el proveedor IA del backend. Nunca pongas esta clave en el frontend.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
AI_CONTEXT_MAX_CHARS=12000
AI_MAX_OUTPUT_TOKENS_CHAT=800
AI_MAX_OUTPUT_TOKENS_COMMAND=800
AI_MAX_OUTPUT_TOKENS_IMAGE=1500
AI_MAX_OUTPUT_TOKENS_CONVERSATION=1000
AI_MAX_OUTPUT_TOKENS_PROPOSAL=1800
AI_PROJECT_BUDGET_TOKENS=100000
# Proactive analysis: rolling per-project quota, shared context only.
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_DEBOUNCE_SECONDS=12
AI_PROACTIVE_POLL_MS=2000
AI_PROACTIVE_MAX_CALLS=8
AI_PROACTIVE_PERIOD_SECONDS=3600
AI_PROACTIVE_EXPLICIT_RESERVE=50000
AI_PROACTIVE_MAX_OUTPUT_TOKENS=700
AI_PROACTIVE_MAX_ATTEMPTS=3
AI_PROACTIVE_RETRY_SECONDS=60
AI_PROACTIVE_RATE_LIMIT_PAUSE_SECONDS=120
AI_PROACTIVE_LEASE_SECONDS=120
AI_PROACTIVE_DEDUP_HOURS=24
